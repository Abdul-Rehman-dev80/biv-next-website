# Copy to .env.local for local development. On cPanel, add these under
# "Setup Node.js App" > Environment variables instead. Never commit real values.

# SMTP account used to send enquiry emails (a cPanel mailbox works well).
# Port 465 uses implicit TLS; port 587 uses STARTTLS.
SMTP_HOST=mail.valuationcertificates.com.au
SMTP_PORT=465
SMTP_USER=no-reply@valuationcertificates.com.au
SMTP_PASS=change-me

# Where enquiries are delivered, and the address they are sent from.
# ENQUIRY_FROM should be the SMTP mailbox (or an alias it may send as).
ENQUIRY_TO=enquiries@valuationcertificates.com.au
ENQUIRY_FROM=no-reply@valuationcertificates.com.au

# Optional: enquiries allowed per visitor IP per 10 minutes (default 5).
# ENQUIRY_RATE_LIMIT_MAX=5
# Optional: directory for rate-limit counters (default: the OS temp directory).
# ENQUIRY_RATE_LIMIT_DIR=/home/<cpanel-user>/tmp
